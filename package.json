{
  "name": "jacob-well-rescue-friend",
  "version": "1.0.0",
  "description": "雅各布井救援游戏 - 微信小游戏",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "movement:check": "node scripts/checkSemiAutoDrive.js && node scripts/checkStaminaEnergy.js",
    "inventory:check": "node scripts/checkInventoryHUD.js",
    "maze:check": "node scripts/checkMazeDiveLifecycle.js && node scripts/checkRescueRagdoll.js",
    "watch": "tsc --watch",
    "clean": "rmdir /s /q dist 2>nul || true",
    "shaders": "node scripts/buildShaders.js",
    "maze:inspect": "node scripts/inspectMaze.js",
    "audio:build": "node scripts/buildAdaptiveAudio.js",
    "audio:check": "node scripts/checkAdaptiveAudio.js && node scripts/checkAdaptiveGameplay.js && node scripts/checkAudioLoading.js",
    "audio:browser": "node scripts/checkAudioEntryBrowser.js",
    "visuals:build": "node scripts/buildTapePreview.js",
    "visuals:check": "node scripts/checkTapeVisuals.js && node scripts/checkTapeEntry.js",
    "game:preview": "node scripts/buildGamePreview.js",
    "fish:check": "node scripts/checkFishInteractions.js",
    "fish:preview": "node scripts/buildGamePreview.js --fish",
    "fish:browser": "node scripts/checkFishInteractionsBrowser.js",
    "platform:check": "node scripts/checkWindowMetrics.js && node scripts/checkScreenOrientation.js",
    "controls:check": "node scripts/checkScreenOrientation.js",
    "controls:preview": "node scripts/buildGamePreview.js --controls",
    "controls:browser": "node scripts/checkControlsBrowser.js",
    "world:art": "python3 scripts/buildContinuousGameplayAssets.py",
    "world:preview": "node scripts/buildContinuousWorldPreview.js",
    "world:check": "tsc --noEmit && node scripts/buildContinuousGameplayPreview.js",
    "world:browser": "node scripts/checkContinuousGameplayBrowser.js",
    "world:stability": "node scripts/checkContinuousGameplayStress.js",
    "world:stress": "node scripts/checkContinuousGameplayStress.js",
    "cave:check": "node scripts/checkCaveRockTrial.js && node scripts/checkCaveRockResources.js",
    "cave:browser": "node scripts/checkCaveRockBrowser.js",
    "package:check": "node scripts/checkPackageBudget.js",
    "prebuild": "npm run package:check",
    "cave:sculpt:build": "node scripts/buildGamePreview.js --sculpt",
    "cave:sculpt:check": "node scripts/checkCaveRockTrial.js --sculpt && node scripts/checkCaveRockResources.js --sculpt && tsc --noEmit -p design/cave-room/sculpt/tsconfig.json",
    "cave:versions": "node scripts/buildCaveVersions.js",
    "cave:versions:check": "node scripts/checkCaveVersions.js",
    "cave:sculpt:browser": "node scripts/checkCaveRockBrowser.js --sculpt",
    "world:entry": "node scripts/checkContinuousGameplayEntry.js",
    "rope:check": "node scripts/checkRopePlacementRegression.js",
    "world:regression": "node scripts/checkShoreRegressionBrowser.js"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
